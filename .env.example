# --- Backend (server/index.ts) ---
PORT=3000
HOST=0.0.0.0
DATA_FILE=./data/config.json

# Required when the frontend is hosted on a different origin (e.g. Vercel + a
# separately hosted backend). Comma-separated list of allowed origins for
# both the REST API and the Socket.IO connection. Leave unset for same-origin
# local development.
CORS_ORIGIN=

# Required before exposing this server publicly, and required when running
# via `docker compose` (NODE_ENV=production there refuses to start without
# it). When unset outside of NODE_ENV=production, mutation endpoints and
# Socket.IO commands are unauthenticated (plain `npm run dev` default).
# When set, clients must send Authorization: Bearer <CONTROL_TOKEN> for
# mutating REST requests and the same token in the Socket.IO connection's
# auth payload. Set this to a long random value.
#
# For `docker compose up`, copy this file to `.env` in the project root
# (compose reads CONTROL_TOKEN from there) rather than exporting it in your
# shell.
CONTROL_TOKEN=

# --- Frontend build (Vite, read at build time) ---
# Base URL of the backend above. Leave unset for local development, where
# the frontend and backend share one origin. Set this on the frontend's
# hosting platform (e.g. Vercel project env vars) when the backend is
# deployed separately, to its public https:// URL with no trailing slash.
VITE_API_URL=
