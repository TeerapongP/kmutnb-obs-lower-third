{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/overlay.ts": {
      "regions": ["sin1"]
    }
  },
  "rewrites": [
    { "source": "/control", "destination": "/index.html" },
    { "source": "/overlay", "destination": "/index.html" }
  ]
}
